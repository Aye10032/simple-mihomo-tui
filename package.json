{
  "name": "simple-mihomo-tui",
  "version": "0.1.0",
  "description": "A lightweight terminal UI for managing Mihomo proxy providers and nodes",
  "module": "src/index.tsx",
  "type": "module",
  "bin": {
    "mihomo-tui": "src/index.tsx"
  },
  "files": [
    "src",
    "config.dev.example.json",
    "README.md"
  ],
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx --config ./config.dev.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "react": "^19.2.6"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
